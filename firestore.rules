rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isMember(chatData) {
      return isAuth() && request.auth.uid in chatData.members;
    }

    // === USERNAMES (reserva de nombre único en el registro) ===
    // Documento: usernames/{username}  ->  { uid: <auth uid> }
    match /usernames/{username} {
      // Cualquiera autenticado puede leer para comprobar disponibilidad
      allow read: if isAuth();
      // Solo se puede CREAR si el documento no existe todavía (garantiza unicidad)
      // y el uid guardado es el del propio usuario.
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid;
      // Nadie reescribe un username ya reservado.
      allow update: if false;
      // Solo el dueño puede liberar su username.
      allow delete: if isAuth()
                    && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
      match /profile/main {
        allow read:  if isAuth();
        allow write: if isOwner(uid);
      }
      match /profile/private {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid);
      }
      match /data/main {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid);
      }
      match /notifications/{nid} {
        allow read:   if isOwner(uid);
        allow write:  if isAuth();
        allow delete: if isOwner(uid);
      }
    }

    match /listings/{lid} {
      allow read:   if isAuth();
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.price is number
                    && request.resource.data.qty   is number
                    && request.resource.data.qty   > 0;
      allow update: if isAuth()
                    && resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
                    && resource.data.uid == request.auth.uid;
    }

    match /friend_requests/{rid} {
      allow read:   if isAuth()
                    && (resource.data.from == request.auth.uid
                     || resource.data.to   == request.auth.uid);
      allow create: if isAuth()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to   != request.auth.uid;
      allow update: if isAuth()
                    && resource.data.to == request.auth.uid;
      allow delete: if isAuth()
                    && (resource.data.from == request.auth.uid
                     || resource.data.to   == request.auth.uid);
    }

    match /friendships/{fid} {
      allow read:   if isAuth()
                    && request.auth.uid in resource.data.members;
      allow create: if isAuth();
      allow delete: if isAuth()
                    && request.auth.uid in resource.data.members;
    }

    // === CHATS (compra/venta y mensajería general) ===
    // Documento: chats/{chatId} -> { members: [uidA, uidB], participantNames, lastMessage, lastMessageAt, ... }
    match /chats/{cid} {
      allow read:   if isMember(resource.data);
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow update: if isMember(resource.data);

      match /messages/{mid} {
        allow read:   if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if isAuth()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 2000;
        allow update: if isAuth()
                      && resource.data.uid == request.auth.uid;
      }
    }

    match /transactions/{tid} {
      allow read:   if isAuth()
                    && (resource.data.sellerUid == request.auth.uid
                     || resource.data.buyerUid  == request.auth.uid);
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }
  }
  {
    "collectionGroup": "notifications",
    "queryScope": "COLLECTION",
    "fields": [
      { "fieldPath": "to",        "order": "ASCENDING" },
      { "fieldPath": "createdAt", "order": "DESCENDING" }
    ]
  }
}
